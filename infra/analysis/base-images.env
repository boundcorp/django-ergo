# Reviewed, digest-pinned base images for the analysis sandbox. Read by
# .github/workflows/analysis-images.yml; tests/test_analysis_images.py checks the
# format. Refresh: docker buildx imagetools inspect <tag> --format '{{json .Manifest.Digest}}'
# (multi-arch index digest), then review and commit.
PYTHON_BASE=docker.io/library/python:3.12.16-slim-bookworm@sha256:44cf1793efa7c7a476bb0f2cff81443f4a072c90c1cb127e2924933daa3e8c64
# Not built here: the controller's TLS sidecar in infra-octo
# kubernetes/apps/ergo-analysis/controller/deployment.yaml. The workflow verifies
# it resolves and prints it with the built digests.
NGINX_UNPRIVILEGED=docker.io/nginxinc/nginx-unprivileged:1.28-alpine@sha256:7377697a821c131a924a7105fafbe7414db4e9fcc77a6f08f776f33f141ec3f8
# gVisor release used by Octo (infra-octo docs/storytime-native-runner.md), for
# the CI smoke test only.
GVISOR_RELEASE=20261102.0
GVISOR_SHA512=2e6671bb2d033b871c5811ab57e16ac570988b0e0054c525f911cfaf191bab3ca4efb08e0a98daa4b9e7d248f9e5776ef2ef2f8a6b82d829646a42924c98bb05
