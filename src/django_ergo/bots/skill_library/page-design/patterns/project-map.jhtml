{# Copy this source into a page, then replace nodes and links. Each link carries explicit SVG endpoints. #}
{% macro project_map(nodes, links, title) -%}
<style>
:root { --pd-bg:#fff; --pd-fg:#18212b; --pd-muted:#5d6b78; --pd-line:#94a3b8; --pd-node:#e0f2fe; --pd-node-line:#0369a1; --pd-link:#64748b; }
@media (prefers-color-scheme:dark) { :root { --pd-bg:#141b23; --pd-fg:#edf3f8; --pd-muted:#b3c0cc; --pd-line:#64748b; --pd-node:#153c57; --pd-node-line:#7dd3fc; --pd-link:#cbd5e1; } }
.pd-map { color:var(--pd-fg); background:var(--pd-bg); } .pd-map svg { background:var(--pd-bg); border:1px solid var(--pd-line); border-radius:8px; height:auto; max-width:100%; } .pd-map .link { stroke:var(--pd-link); stroke-width:2; } .pd-map .node { fill:var(--pd-node); stroke:var(--pd-node-line); stroke-width:2; } .pd-map text { fill:var(--pd-fg); font:12px system-ui,sans-serif; text-anchor:middle; } .pd-map ul { padding-left:20px; } .pd-map li { margin:6px 0; } .pd-map .state { color:var(--pd-muted); }
</style>
<section class="pd-map" aria-labelledby="map-title"><h1 id="map-title">{{ title }}</h1>
<svg viewBox="0 0 720 340" role="img" aria-labelledby="map-svg-title"><title id="map-svg-title">Areas and relationships in {{ title }}</title>
{% for link in links %}<line class="link" x1="{{ link["x1"] }}" y1="{{ link["y1"] }}" x2="{{ link["x2"] }}" y2="{{ link["y2"] }}" />{% endfor %}
{% for node in nodes %}<g><circle class="node" cx="{{ node["x"] }}" cy="{{ node["y"] }}" r="54" /><text x="{{ node["x"] }}" y="{{ node["y"] - 7 }}">{{ node["name"] }}</text><text x="{{ node["x"] }}" y="{{ node["y"] + 12 }}">{{ node["state"] }}</text></g>{% endfor %}
</svg>
<h2>Areas</h2><ul>{% for node in nodes %}<li><strong>{{ node["name"] }}</strong> <span class="state">({{ node["state"] }})</span> — {{ node["purpose"] }}</li>{% endfor %}</ul>
<h2>Relationships</h2><ul>{% for link in links %}<li>{{ link["from"] }} → {{ link["to"] }}: {{ link["relationship"] }}</li>{% endfor %}</ul>
</section>
{%- endmacro %}
{% set nodes = [
  {"name":"Audience", "state":"Validated", "purpose":"Who the service is for", "x":120, "y":160},
  {"name":"Booking", "state":"Building", "purpose":"Appointment selection and confirmation", "x":360, "y":80},
  {"name":"Care plan", "state":"Planned", "purpose":"Follow-up guidance after a booking", "x":360, "y":255},
  {"name":"Messages", "state":"Active", "purpose":"Reminders and updates", "x":600, "y":160}
] %}
{% set links = [
  {"from":"Audience", "to":"Booking", "relationship":"sets booking needs", "x1":174, "y1":143, "x2":306, "y2":97},
  {"from":"Booking", "to":"Care plan", "relationship":"starts the care plan", "x1":360, "y1":134, "x2":360, "y2":201},
  {"from":"Booking", "to":"Messages", "relationship":"sends confirmation", "x1":414, "y1":97, "x2":546, "y2":143},
  {"from":"Care plan", "to":"Messages", "relationship":"sends reminders", "x1":414, "y1":238, "x2":546, "y2":177}
] %}
{{ project_map(nodes, links, "Community-care project map") }}
