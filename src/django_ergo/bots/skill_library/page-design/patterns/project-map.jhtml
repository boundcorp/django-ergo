{# Copy this source into a page, replace the example dictionaries, and choose only the panels useful for this subject. #}
{% macro project_map(title, subtitle, updated, counts=[], milestones=[], remaining=None, parts=[], next_step=None, needs_your_call=None, changed=[], relationships=[], accent="#8b5cf6") -%}
<style>
:root { --pd-bg:#fff; --pd-fg:#18212b; --pd-muted:#5d6b78; --pd-line:#cbd5df; --pd-card:#f6f8fa; --pd-accent:{{ accent }}; --pd-done:#087f5b; --pd-progress:#9a6700; --pd-stuck:#b42318; --pd-idle:#667085; }
@media (prefers-color-scheme:dark) { :root { --pd-bg:#111318; --pd-fg:#f4f6f8; --pd-muted:#b6bec9; --pd-line:#3a4554; --pd-card:#1b2028; --pd-done:#72d5b0; --pd-progress:#f5c36a; --pd-stuck:#ff9b91; --pd-idle:#b5bdc9; } }
.pd-map { color:var(--pd-fg); background:var(--pd-bg); padding:clamp(16px,3vw,32px); font:16px/1.45 system-ui,sans-serif; } .pd-map * { box-sizing:border-box; } .pd-map h1,.pd-map h2,.pd-map h3,.pd-map p { margin:0; } .pd-map h1 { font-size:clamp(1.7rem,4vw,2.5rem); } .pd-map h2 { font-size:1rem; letter-spacing:.08em; text-transform:uppercase; } .pd-map h3 { font-size:1.05rem; } .pd-map .subtitle,.pd-map .updated,.pd-map .footnote,.pd-map .detail { color:var(--pd-muted); } .pd-map .subtitle { margin-top:4px; font-size:1.1rem; } .pd-map .updated { margin-top:8px; font-size:.9rem; } .pd-map .counts,.pd-map .chips { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0 0; padding:0; list-style:none; } .pd-map .count,.pd-map .chip,.pd-map .pill { border:1px solid var(--pd-line); border-radius:999px; padding:3px 9px; font-size:.88rem; } .pd-map .count strong { font-size:1rem; } .pd-map .state-done { color:var(--pd-done); } .pd-map .state-in-progress { color:var(--pd-progress); } .pd-map .state-stuck { color:var(--pd-stuck); } .pd-map .state-not-started,.pd-map .state-later,.pd-map .state-next { color:var(--pd-idle); }
.pd-map .milestones { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:12px; list-style:none; margin:28px 0; padding:0; } .pd-map .milestone { border-top:4px solid var(--pd-line); padding-top:10px; } .pd-map .milestone.state-done { border-color:var(--pd-done); } .pd-map .milestone.state-current { border-color:var(--pd-accent); } .pd-map .marker { display:inline-block; margin-bottom:6px; border-radius:999px; background:var(--pd-accent); color:#fff; padding:3px 9px; font-size:.8rem; font-weight:700; } .pd-map .milestone .state { color:var(--pd-muted); font-size:.9rem; }
.pd-map .remaining { margin:0 0 24px; } .pd-map .remaining h2 { display:inline; margin-right:10px; } .pd-map .layout { display:grid; grid-template-columns:minmax(0,2fr) minmax(260px,1fr); gap:20px; } .pd-map .panel { border:1px solid var(--pd-line); border-radius:12px; background:var(--pd-card); padding:16px; } .pd-map .parts-heading { display:flex; justify-content:space-between; gap:12px; align-items:baseline; } .pd-map .parts-heading p { color:var(--pd-muted); } .pd-map .parts { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; list-style:none; margin:14px 0 0; padding:0; } .pd-map .part { min-height:150px; border:1px solid var(--pd-line); border-radius:10px; background:var(--pd-bg); padding:14px; display:flex; flex-direction:column; gap:9px; } .pd-map .part.changed { outline:2px solid var(--pd-accent); outline-offset:2px; } .pd-map .changed-marker { color:var(--pd-accent); font-size:.8rem; font-weight:700; text-transform:uppercase; } .pd-map .part.stuck { border-color:var(--pd-stuck); background:repeating-linear-gradient(135deg,transparent 0,transparent 8px,color-mix(in srgb,var(--pd-stuck) 12%,transparent) 8px,color-mix(in srgb,var(--pd-stuck) 12%,transparent) 16px); } .pd-map .progress { height:8px; overflow:hidden; border-radius:999px; background:var(--pd-line); } .pd-map .progress span { display:block; height:100%; background:var(--pd-accent); } .pd-map .footnote { margin-top:auto; font-size:.9rem; } .pd-map .waiting { color:var(--pd-stuck); font-weight:700; }
.pd-map .side { display:grid; align-content:start; gap:12px; } .pd-map .side h2 { margin-bottom:8px; } .pd-map .call { border-color:var(--pd-stuck); } .pd-map .default { margin-top:8px; font-weight:700; } .pd-map .changed-list,.pd-map .relationships { margin:0; padding-left:20px; } .pd-map .changed-list li,.pd-map .relationships li { margin:7px 0; } .pd-map .changed-list time { color:var(--pd-muted); font-size:.9rem; }
@media (max-width:700px) { .pd-map .layout { grid-template-columns:1fr; } }
</style>
<section class="pd-map" aria-labelledby="project-map-title">
  <header>
    <h1 id="project-map-title">{{ title }}</h1>
    {% if subtitle %}<p class="subtitle">{{ subtitle }}</p>{% endif %}
    {% if updated %}<p class="updated">Updated {{ updated }}</p>{% endif %}
    {% if counts %}<ul class="counts" aria-label="Headline counts">{% for count in counts %}<li class="count state-{{ count["state"]|default("not-started")|replace(" ", "-") }}"><strong>{{ count["value"] }}</strong> {{ count["label"] }}</li>{% endfor %}</ul>{% endif %}
  </header>
  {% if milestones %}<ol class="milestones" aria-label="Milestones">{% for milestone in milestones %}<li class="milestone state-{{ milestone["state"]|replace(" ", "-") }}">{% if milestone["state"] == "current" %}<span class="marker">You are here</span>{% endif %}<h2>{{ milestone["name"] }}</h2><p class="state">{{ milestone["state"]|title }}{% if milestone.get("date") %} · {{ milestone["date"] }}{% endif %}</p></li>{% endfor %}</ol>{% endif %}
  {% if remaining %}<section class="remaining" aria-labelledby="remaining-title"><h2 id="remaining-title">{{ remaining["count"] }} left for {{ remaining["milestone"] }}</h2><ul class="chips">{% for item in remaining["items"] %}<li class="chip state-{{ item["state"]|replace(" ", "-") }}">{{ item["name"] }} · {{ item["state"] }}</li>{% endfor %}</ul></section>{% endif %}
  {% if parts or next_step or needs_your_call or changed %}<div class="layout">
    {% if parts %}<section class="panel" aria-labelledby="parts-title"><div class="parts-heading"><h2 id="parts-title">Parts</h2><p>{{ parts|selectattr("state", "equalto", "done")|list|length }} of {{ parts|length }} done</p></div><ul class="parts">{% for part in parts %}<li class="part {{ part["state"]|replace(" ", "-") }}{% if part.get("changed") %} changed{% endif %}"><h3>{{ part["name"] }}</h3><span class="pill state-{{ part["state"]|replace(" ", "-") }}">{{ part["state"]|title }}</span>{% if part.get("changed") %}<span class="changed-marker">Changed since last update</span>{% endif %}{% if part.get("progress") is not none %}<span>{{ part["progress"] }}% complete</span><div class="progress" role="progressbar" aria-label="{{ part["name"] }} progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ part["progress"] }}"><span style="width:{{ part["progress"] }}%"></span></div>{% endif %}{% if part.get("waiting_on") %}<p class="waiting">Waiting on {{ part["waiting_on"] }}</p>{% endif %}{% if part.get("footnote") %}<p class="footnote">{{ part["footnote"] }}</p>{% endif %}</li>{% endfor %}</ul></section>{% endif %}
    {% if next_step or needs_your_call or changed %}<aside class="side" aria-label="Project map updates">{% if next_step %}<section class="panel"><h2>Next step</h2><h3>{{ next_step["title"] }}</h3><p class="detail">{{ next_step["detail"] }}</p></section>{% endif %}{% if needs_your_call %}<section class="panel call"><h2>Needs your call</h2><h3>{{ needs_your_call["question"] }}</h3><p class="default">{{ needs_your_call["default"] }}</p></section>{% endif %}{% if changed %}<section class="panel"><h2>Changed since last update</h2><ul class="changed-list">{% for item in changed %}<li><strong>{{ item["name"] }}</strong> → {{ item["state"] }} <time>{{ item["time"] }}</time></li>{% endfor %}</ul></section>{% endif %}</aside>{% endif %}
  </div>{% endif %}
  {% if relationships %}<section class="panel" aria-labelledby="relationships-title"><h2 id="relationships-title">Relationships</h2><ul class="relationships">{% for relationship in relationships %}<li>{{ relationship["from"] }} → {{ relationship["to"] }}: {{ relationship["detail"] }}</li>{% endfor %}</ul></section>{% endif %}
</section>
{%- endmacro %}
{% set sample_counts = [{"value":"3", "label":"rooms packed", "state":"done"}, {"value":"1", "label":"stuck", "state":"stuck"}] %}
{% set sample_milestones = [{"name":"Plan the move", "state":"done", "date":"6 May"}, {"name":"Prepare the house", "state":"current"}, {"name":"Moving day", "state":"next"}, {"name":"Settle in", "state":"later"}] %}
{% set sample_remaining = {"count":"2", "milestone":"Moving day", "items":[{"name":"Pack kitchen", "state":"in progress"}, {"name":"Confirm utilities", "state":"stuck"}]} %}
{% set sample_parts = [{"name":"Mover booking", "state":"done", "footnote":"Booked for 24 May"}, {"name":"Kitchen packing", "state":"in progress", "progress":70, "footnote":"Two cupboards left", "changed":true}, {"name":"Utility transfer", "state":"stuck", "waiting_on":"the landlord's meter reading", "footnote":"Needed before moving day", "changed":true}, {"name":"Bedroom packing", "state":"not started", "footnote":"After the kitchen"}] %}
{% set sample_next = {"title":"Finish kitchen packing", "detail":"Then label the boxes for the movers"} %}
{% set sample_call = {"question":"Keep the old sofa?", "default":"No reply by Friday 10:00 → donate it and keep the move booking"} %}
{% set sample_changed = [{"name":"Kitchen packing", "state":"70% complete", "time":"08:20"}, {"name":"Utility transfer", "state":"Stuck", "time":"08:45"}] %}
{{ project_map("Hernandez house move", "Project map", "08:45 · morning check-in", sample_counts, sample_milestones, sample_remaining, sample_parts, sample_next, sample_call, sample_changed, accent="#8167dc") }}
