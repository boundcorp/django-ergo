+            f.state().canonicalize().unwrap()
+        );
+        assert_eq!(std::fs::read_dir(f.state()).unwrap().count(), 0);
+        for name in ["auth.json", "config.toml"] {
+            assert_eq!(
+                std::fs::read(f.home().join(name)).unwrap(),
+                b"synthetic-sentinel"
+            );
+        }
+    }
+    #[test]
+    fn rejects_empty_and_relative() {
