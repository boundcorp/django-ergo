@@ -0,0 +1,327 @@
+//! Optional separation of mutable runtime state from `CODEX_HOME`.
+//!
+//! By default every Codex-generated file (installation id, SQLite state and
+//! logs, helper aliases, session rollouts and index, history, shell snapshots,
+//! memories, caches, embedded system skills) lives under `CODEX_HOME`, next to
+//! `auth.json` and `config.toml`.
+//!
+//! When `CODEX_RUNTIME_HOME` is set, those runtime artifacts are written below
+//! that directory instead while authentication and user configuration continue
+//! to be read from `CODEX_HOME`. This lets a launcher keep `CODEX_HOME`
+//! read-only (for example under a sandbox) and give each job its own private,
+//! disposable runtime root.
+//!
+//! The root is validated once per process and must:
+//! - be an absolute, already-existing directory (it is never created here);
+//! - contain no symlinked component and no `..` component;
+//! - not be group- or world-writable (Unix);
+//! - neither contain nor be contained by the canonical `CODEX_HOME`.
+//!
+//! An invalid value is an error. Callers that would write runtime state must
+//! propagate it and must never fall back to `CODEX_HOME`.
+use std::ffi::OsStr;
+use std::io;
+use std::path::Component;
+use std::path::Path;
+use std::path::PathBuf;
+use std::sync::OnceLock;
+
+use codex_utils_absolute_path::AbsolutePathBuf;
+
+/// Environment variable selecting the runtime state root.
+pub const CODEX_RUNTIME_HOME_ENV: &str = "CODEX_RUNTIME_HOME";
+
+static CONFIGURED: OnceLock<Result<Option<AbsolutePathBuf>, (io::ErrorKind, String)>> =
+    OnceLock::new();
+
+/// Returns the validated runtime root when `CODEX_RUNTIME_HOME` is set.
+///
+/// The environment is read and validated once per process; later changes to
+/// the process environment do not move runtime state mid-run.
+pub fn configured_runtime_home() -> io::Result<Option<AbsolutePathBuf>> {
+    CONFIGURED
+        .get_or_init(|| {
+            let Some(configured) = std::env::var_os(CODEX_RUNTIME_HOME_ENV) else {
+                return Ok(None);
+            };
+            let home = crate::find_codex_home().map_err(|err| (err.kind(), err.to_string()))?;
+            validate_runtime_home(home.as_path(), &configured)
+                .and_then(AbsolutePathBuf::from_absolute_path)
+                .map(Some)
+                .map_err(|err| (err.kind(), err.to_string()))
+        })
+        .clone()
+        .map_err(|(kind, message)| io::Error::new(kind, message))
+}
+
+/// Root for mutable runtime state derived from `codex_home`.
+///
+/// Returns `codex_home` unchanged unless `CODEX_RUNTIME_HOME` is set, in which
+/// case the validated runtime root is returned. Writers must use this
+/// fallible form so an invalid root can never fall back to `CODEX_HOME`.
+pub fn try_runtime_home_for(codex_home: &Path) -> io::Result<PathBuf> {
+    Ok(match configured_runtime_home()? {
+        Some(root) => root.into_path_buf(),
+        None => codex_home.to_path_buf(),
+    })
+}
+
+/// [`try_runtime_home_for`] for [`AbsolutePathBuf`] callers.
+pub fn try_runtime_home_for_abs(codex_home: &AbsolutePathBuf) -> io::Result<AbsolutePathBuf> {
+    Ok(configured_runtime_home()?.unwrap_or_else(|| codex_home.clone()))
+}
+
+/// Infallible lookup for code that only *reads* runtime state or computes a
+/// path that a fallible writer creates later.
+///
+/// With an invalid `CODEX_RUNTIME_HOME` this returns a path inside a
+/// non-existent, non-creatable location so readers find nothing and any
+/// accidental writer fails instead of touching `CODEX_HOME`. The CLI entry
+/// point rejects an invalid root before any work starts.
+pub fn runtime_home_for(codex_home: &AbsolutePathBuf) -> AbsolutePathBuf {
+    match configured_runtime_home() {
+        Ok(Some(root)) => root,
+        Ok(None) => codex_home.clone(),
+        Err(_) => invalid_runtime_home_placeholder(),
+    }
+}
+
+/// Borrowed form of [`runtime_home_for`] for trait accessors returning `&Path`.
+pub fn runtime_home_path_for(codex_home: &Path) -> &Path {
+    static ROOT: OnceLock<Result<Option<AbsolutePathBuf>, ()>> = OnceLock::new();
+    match ROOT.get_or_init(|| configured_runtime_home().map_err(|_| ())) {
+        Ok(Some(root)) => root.as_path(),
+        Ok(None) => codex_home,
+        Err(()) => Path::new(INVALID_RUNTIME_HOME_PLACEHOLDER),
+    }
+}
+
+#[cfg(unix)]
+const INVALID_RUNTIME_HOME_PLACEHOLDER: &str = "/proc/self/fdinfo/codex-runtime-home-invalid";
+#[cfg(not(unix))]
+const INVALID_RUNTIME_HOME_PLACEHOLDER: &str = "\\\\?\\codex-runtime-home-invalid";
+
+fn invalid_runtime_home_placeholder() -> AbsolutePathBuf {
+    AbsolutePathBuf::from_absolute_path(PathBuf::from(INVALID_RUNTIME_HOME_PLACEHOLDER))
+        .unwrap_or_else(|_| unreachable!("placeholder path is absolute"))
+}
+
+/// Validates `configured` as a runtime root separate from `codex_home`.
+///
+/// Pure function (no caching, no creation) so it can be tested directly.
+pub fn validate_runtime_home(codex_home: &Path, configured: &OsStr) -> io::Result<PathBuf> {
+    let invalid = |reason: &str| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!(
+                "{CODEX_RUNTIME_HOME_ENV} {configured:?} is invalid: {reason}. It must be an \
+                 existing absolute directory without symlinks, not group/world-writable, and \
+                 separate from CODEX_HOME"
+            ),
+        )
+    };
+    if configured.is_empty() {
+        return Err(invalid("empty value"));
+    }
+    let root = Path::new(configured);
+    if !root.is_absolute() {
+        return Err(invalid("not an absolute path"));
+    }
+    let mut prefix = PathBuf::new();
+    for component in root.components() {
+        if matches!(component, Component::ParentDir | Component::CurDir) {
+            return Err(invalid("contains `..`"));
+        }
+        prefix.push(component.as_os_str());
+        let metadata = std::fs::symlink_metadata(&prefix).map_err(|err| {
+            if err.kind() == io::ErrorKind::NotFound {
+                invalid("does not exist")
+            } else {
+                io::Error::new(err.kind(), format!("{CODEX_RUNTIME_HOME_ENV}: {err}"))
+            }
+        })?;
+        if metadata.file_type().is_symlink() {
+            return Err(invalid("contains a symlinked component"));
+        }
+        if !metadata.is_dir() {
+            return Err(invalid("is not a directory"));
+        }
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        let mode = std::fs::symlink_metadata(root)?.permissions().mode();
+        if mode & 0o022 != 0 {
+            return Err(invalid("is group- or world-writable"));
+        }
+    }
+    let root = root.canonicalize()?;
+    // CODEX_HOME may not exist yet when it defaults to ~/.codex.
+    let home = codex_home
+        .canonicalize()
+        .unwrap_or_else(|_| codex_home.to_path_buf());
+    if root.starts_with(&home) || home.starts_with(&root) {
+        return Err(invalid("overlaps CODEX_HOME"));
+    }
+    Ok(root)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+    use std::ffi::OsString;
+
+    struct Fixture {
+        dir: tempfile::TempDir,
+    }
+
+    impl Fixture {
+        fn new() -> Self {
+            let dir = tempfile::tempdir().expect("tempdir");
+            std::fs::create_dir(dir.path().join("home")).expect("home");
+            std::fs::create_dir(dir.path().join("state")).expect("state");
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                std::fs::set_permissions(
+                    dir.path().join("state"),
+                    std::fs::Permissions::from_mode(0o700),
+                )
+                .expect("chmod");
+            }
+            Self { dir }
+        }
+        fn base(&self) -> PathBuf {
+            self.dir.path().canonicalize().expect("canonical base")
+        }
+        fn home(&self) -> PathBuf {
+            self.base().join("home")
+        }
+        fn state(&self) -> PathBuf {
+            self.base().join("state")
+        }
+        fn validate(&self, path: impl Into<OsString>) -> io::Result<PathBuf> {
+            validate_runtime_home(&self.home(), &path.into())
+        }
+    }
+
+    #[test]
+    fn accepts_private_separate_directory_without_touching_home() {
+        let f = Fixture::new();
+        for name in ["auth.json", "config.toml"] {
+            std::fs::write(f.home().join(name), b"synthetic-sentinel").expect("write");
+        }
+        assert_eq!(f.validate(f.state()).expect("valid"), f.state());
+        assert_eq!(std::fs::read_dir(f.state()).expect("read").count(), 0);
+        for name in ["auth.json", "config.toml"] {
+            assert_eq!(
+                std::fs::read(f.home().join(name)).expect("read"),
+                b"synthetic-sentinel"
+            );
+        }
+    }
+
+    #[test]
+    fn rejects_empty_relative_and_traversal() {
+        let f = Fixture::new();
+        for path in [
+            OsString::new(),
+            OsString::from("state"),
+            OsString::from("../state"),
+            f.state().join("..").join("state").into_os_string(),
+        ] {
+            assert!(f.validate(path.clone()).is_err(), "{path:?}");
+        }
+        // `Path::components` drops non-leading `.`; it names the same directory.
+        assert_eq!(
+            f.validate(f.state().join(".")).expect("same dir"),
+            f.state()
+        );
+    }
+
+    #[test]
+    fn rejects_missing_without_creating_it() {
+        let f = Fixture::new();
+        let missing = f.base().join("missing");
+        let err = f.validate(&missing).expect_err("missing");
+        assert!(err.to_string().contains("does not exist"));
+        assert!(!missing.exists());
+    }
+
+    #[test]
+    fn rejects_regular_file() {
+        let f = Fixture::new();
+        let file = f.base().join("file");
+        std::fs::write(&file, "x").expect("write");
+        assert!(f.validate(&file).is_err());
+    }
+
+    #[test]
+    fn rejects_overlap_with_codex_home() {
+        let f = Fixture::new();
+        let nested = f.home().join("runtime");
+        std::fs::create_dir(&nested).expect("mkdir");
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            for p in [&nested, &f.home(), &f.base()] {
+                std::fs::set_permissions(p, std::fs::Permissions::from_mode(0o700)).expect("chmod");
+            }
+        }
+        for path in [f.home(), nested, f.base()] {
+            let err = f.validate(&path).expect_err("overlap");
+            assert!(err.to_string().contains("overlaps CODEX_HOME"), "{err}");
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn rejects_symlinked_root_and_ancestor() {
+        let f = Fixture::new();
+        let link = f.base().join("link");
+        std::os::unix::fs::symlink(f.state(), &link).expect("symlink");
+        assert!(f.validate(&link).is_err());
+        let ancestor = f.base().join("ancestor");
+        std::os::unix::fs::symlink(f.base(), &ancestor).expect("symlink");
+        assert!(f.validate(ancestor.join("state")).is_err());
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn rejects_group_or_world_writable_root() {
+        use std::os::unix::fs::PermissionsExt;
+        let f = Fixture::new();
+        for mode in [0o770, 0o707, 0o777] {
+            std::fs::set_permissions(f.state(), std::fs::Permissions::from_mode(mode))
+                .expect("chmod");
+            assert!(f.validate(f.state()).is_err(), "{mode:o}");
+        }
+    }
+
+    #[test]
+    fn distinct_job_roots_resolve_to_distinct_physical_paths() {
+        let first = Fixture::new();
+        let second = Fixture::new();
+        assert_ne!(
+            first.validate(first.state()).expect("first"),
+            second.validate(second.state()).expect("second")
+        );
+    }
+
+    #[test]
+    fn unset_env_keeps_codex_home() {
+        // The process-wide cache is only populated when the variable is unset
+        // in the test runner; this mirrors the default (opt-in absent) path.
+        if std::env::var_os(CODEX_RUNTIME_HOME_ENV).is_some() {
+            return;
+        }
+        let f = Fixture::new();
+        let home = AbsolutePathBuf::from_absolute_path(f.home()).expect("abs");
+        assert_eq!(runtime_home_for(&home), home);
+        assert_eq!(
+            try_runtime_home_for(home.as_path()).expect("default"),
+            home.to_path_buf()
+        );
+    }
+}
