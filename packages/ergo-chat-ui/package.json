{
  "name": "@ergo/chat-ui",
  "version": "0.1.0",
  "description": "Presentational React chat transcript and composer. The host owns transport, auth and tools.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:react18": "node scripts/react18.mjs && REACT_MAJOR=18 vitest run",
    "test:all": "npm run typecheck && npm test && npm run test:react18",
    "fixtures": "bash scripts/fixtures.sh",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^21.0.3",
    "highlight.js": "^11.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
